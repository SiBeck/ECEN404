@{
    ViewData["Title"] = "Privacy Policy";
}

<div class="container my-5">
    <h1 class="mb-4">@ViewData["Title"]</h1>

    <div class="card shadow-sm mb-4">
        <div class="card-body">
            <h3>Your Privacy Matters</h3>
            <p class="lead">We are committed to protecting your personal health information and maintaining the highest standards of privacy and security.</p>
        </div>
    </div>

    <div class="card shadow-sm mb-4">
        <div class="card-body">
            <h4><i class="bi bi-collection text-primary"></i> Information We Collect</h4>
            <ul>
                <li><strong>Patient Identification:</strong> Patient ID, name, date of birth</li>
                <li><strong>Contact Information:</strong> Email address, phone number</li>
                <li><strong>Medical Records:</strong> Files uploaded by your healthcare providers</li>
                <li><strong>Account Information:</strong> Login credentials and access logs</li>
            </ul>
        </div>
    </div>

    <div class="card shadow-sm mb-4">
        <div class="card-body">
            <h4><i class="bi bi-shield-check text-success"></i> How We Use Your Information</h4>
            <ul>
                <li>To provide secure access to your medical records</li>
                <li>To authenticate your identity when you log in</li>
                <li>To communicate important updates about your account</li>
                <li>To maintain and improve our services</li>
                <li>To comply with legal and regulatory requirements</li>
            </ul>
        </div>
    </div>

    <div class="card shadow-sm mb-4">
        <div class="card-body">
            <h4><i class="bi bi-lock-fill text-warning"></i> Security Measures</h4>
            <p><strong>We implement industry-standard security practices:</strong></p>
            <ul>
                <li><strong>Encryption:</strong> All files are encrypted using AES-256 encryption</li>
                <li><strong>Secure Authentication:</strong> Passwords are hashed using BCrypt</li>
                <li><strong>HTTPS:</strong> All communications are encrypted in transit</li>
                <li><strong>Access Control:</strong> You can only access your own medical records</li>
                <li><strong>Audit Logging:</strong> All file access is logged for security</li>
            </ul>
        </div>
    </div>

    <div class="card shadow-sm mb-4">
        <div class="card-body">
            <h4><i class="bi bi-people text-info"></i> Information Sharing</h4>
            <p>We do not sell, rent, or share your personal health information with third parties except:</p>
            <ul>
                <li>With your explicit consent</li>
                <li>To your authorized healthcare providers</li>
                <li>When required by law or legal process</li>
                <li>To protect the safety and security of our systems</li>
            </ul>
        </div>
    </div>

    <div class="card shadow-sm mb-4">
        <div class="card-body">
            <h4><i class="bi bi-person-check text-primary"></i> Your Rights</h4>
            <p>You have the right to:</p>
            <ul>
                <li>Access your medical records at any time</li>
                <li>Download copies of your files</li>
                <li>Request corrections to your personal information</li>
                <li>Close your account</li>
                <li>Request a copy of your data</li>
            </ul>
        </div>
    </div>

    <div class="card shadow-sm mb-4">
        <div class="card-body">
            <h4><i class="bi bi-cookie text-warning"></i> Cookies and Session Data</h4>
            <p>We use cookies to:</p>
            <ul>
                <li>Keep you logged in during your session</li>
                <li>Remember your preferences</li>
                <li>Improve the performance of our website</li>
            </ul>
            <p class="mb-0">You can disable cookies in your browser settings, but this may affect functionality.</p>
        </div>
    </div>

    <div class="card shadow-sm mb-4">
        <div class="card-body">
            <h4><i class="bi bi-exclamation-triangle text-danger"></i> Data Breach Notification</h4>
            <p class="mb-0">In the unlikely event of a data breach that affects your personal health information, we will notify you and relevant authorities as required by law.</p>
        </div>
    </div>

    <div class="card shadow-sm">
        <div class="card-body">
            <h4><i class="bi bi-envelope text-primary"></i> Contact Us</h4>
            <p>If you have questions about this privacy policy or how we handle your information, please contact:</p>
            <address>
                <strong>Privacy Officer</strong><br>
                Medical Imaging System<br>
                Email: privacy@medical-imaging.example<br>
                Phone: (555) 123-4567
            </address>
            <p class="mb-0"><small class="text-muted">Last Updated: December 2024</small></p>
        </div>
    </div>
</div>
