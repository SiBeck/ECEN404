@{
    ViewData["Title"] = "Welcome";
}

<div class="text-center mt-5">
    <h1 class="display-4 mb-4">Welcome to Patient Portal</h1>
    <p class="lead text-muted">Secure access to your medical records and files</p>
    
    @if (User.Identity?.IsAuthenticated != true)
    {
        <div class="mt-5">
            <div class="row justify-content-center">
                <div class="col-md-8">
                    <div class="card shadow-sm mb-4">
                        <div class="card-body p-5">
                            <h3 class="card-title mb-4">Access Your Medical Records</h3>
                            <p class="card-text">View, download, and manage your medical files securely from anywhere.</p>
                            
                            <div class="d-grid gap-3 d-md-flex justify-content-md-center mt-4">
                                <a asp-controller="Account" asp-action="Login" class="btn btn-primary btn-lg px-5">
                                    <i class="bi bi-box-arrow-in-right"></i> Login
                                </a>
                                <a asp-controller="Account" asp-action="Register" class="btn btn-outline-primary btn-lg px-5">
                                    <i class="bi bi-person-plus"></i> Register
                                </a>
                            </div>
                        </div>
                    </div>
                    
                    <div class="row mt-5">
                        <div class="col-md-4">
                            <div class="text-center">
                                <i class="bi bi-shield-check display-1 text-primary"></i>
                                <h5 class="mt-3">Secure & Private</h5>
                                <p class="text-muted">Your data is encrypted and protected</p>
                            </div>
                        </div>
                        <div class="col-md-4">
                            <div class="text-center">
                                <i class="bi bi-file-earmark-medical display-1 text-success"></i>
                                <h5 class="mt-3">Easy Access</h5>
                                <p class="text-muted">View your files anytime, anywhere</p>
                            </div>
                        </div>
                        <div class="col-md-4">
                            <div class="text-center">
                                <i class="bi bi-download display-1 text-info"></i>
                                <h5 class="mt-3">Download Files</h5>
                                <p class="text-muted">Save copies of your medical records</p>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    }
    else
    {
        <div class="mt-5">
            <a asp-controller="Home" asp-action="Dashboard" class="btn btn-primary btn-lg">
                Go to Dashboard
            </a>
        </div>
    }
</div>
