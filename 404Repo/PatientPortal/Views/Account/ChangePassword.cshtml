@model ChangePasswordViewModel
@{
    ViewData["Title"] = "Change Password";
}

<div class="row justify-content-center mt-5">
    <div class="col-md-6 col-lg-5">
        <div class="card shadow-sm">
            <div class="card-body p-5">
                <div class="text-center mb-4">
                    <i class="bi bi-key-fill display-1 text-primary"></i>
                    <h2 class="card-title mt-3">Change Password</h2>
                    <p class="text-muted">Update your account password</p>
                </div>
                
                <form asp-action="ChangePassword" method="post">
                    <div asp-validation-summary="All" class="alert alert-danger" role="alert"></div>
                    
                    <div class="alert alert-info" role="alert">
                        <i class="bi bi-info-circle-fill"></i>
                        Choose a strong password that you haven't used before.
                    </div>
                    
                    <div class="mb-3">
                        <label asp-for="CurrentPassword" class="form-label">
                            <i class="bi bi-lock"></i> @Html.DisplayNameFor(m => m.CurrentPassword)
                        </label>
                        <input asp-for="CurrentPassword" class="form-control" placeholder="Enter your current password" autofocus />
                        <span asp-validation-for="CurrentPassword" class="text-danger"></span>
                    </div>
                    
                    <hr class="my-4">
                    
                    <div class="mb-3">
                        <label asp-for="NewPassword" class="form-label">
                            <i class="bi bi-lock-fill"></i> @Html.DisplayNameFor(m => m.NewPassword)
                        </label>
                        <input asp-for="NewPassword" class="form-control" placeholder="Enter your new password" />
                        <span asp-validation-for="NewPassword" class="text-danger"></span>
                        <small class="form-text text-muted">Minimum 6 characters</small>
                    </div>
                    
                    <div class="mb-4">
                        <label asp-for="ConfirmNewPassword" class="form-label">
                            <i class="bi bi-lock-fill"></i> @Html.DisplayNameFor(m => m.ConfirmNewPassword)
                        </label>
                        <input asp-for="ConfirmNewPassword" class="form-control" placeholder="Re-enter your new password" />
                        <span asp-validation-for="ConfirmNewPassword" class="text-danger"></span>
                    </div>
                    
                    <div class="d-grid gap-2">
                        <button type="submit" class="btn btn-primary btn-lg">
                            <i class="bi bi-check-circle"></i> Update Password
                        </button>
                        <a asp-controller="Home" asp-action="Dashboard" class="btn btn-outline-secondary">
                            <i class="bi bi-x-circle"></i> Cancel
                        </a>
                    </div>
                </form>
                
                <hr class="my-4">
                
                <div class="alert alert-warning mb-0" role="alert">
                    <i class="bi bi-exclamation-triangle-fill"></i>
                    <strong>Security Tip:</strong> Never share your password with anyone. 
                    We will never ask for your password via email or phone.
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
