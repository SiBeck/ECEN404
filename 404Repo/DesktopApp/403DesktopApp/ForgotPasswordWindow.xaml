<Window x:Class="_403DesktopApp.ForgotPasswordWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Verify Provider"
        Height="240" Width="420"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="#F0F0F0">
    <Border Margin="10" Background="White" Padding="16" BorderBrush="#CCCCCC" BorderThickness="1" CornerRadius="4">
        <StackPanel>
            <TextBlock Text="Verify Provider for Password Reset" FontWeight="SemiBold" FontSize="16" Margin="0,0,0,10"/>
            <TextBlock Text="Provider ID:" FontSize="12"/>
            <TextBox Text="{Binding ProviderId, UpdateSourceTrigger=PropertyChanged}" Height="30" Margin="0,4,0,10"/>
            <TextBlock Text="Registered Email:" FontSize="12"/>
            <TextBox Text="{Binding Email, UpdateSourceTrigger=PropertyChanged}" Height="30" Margin="0,4,0,10"/>
            <TextBlock Text="{Binding StatusMessage}" Foreground="Red" FontSize="12" Margin="0,4,0,10" TextWrapping="Wrap" MinHeight="22"/>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,8,0,0">
                <Button Content="Verify" Width="90" Margin="0,0,8,0" Click="Verify_Click" IsDefault="True"/>
                <Button Content="Cancel" Width="90" Click="Cancel_Click" IsCancel="True"/>
            </StackPanel>
        </StackPanel>
    </Border>
</Window>