<Window x:Class="_403DesktopApp.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="403 Desktop Application" 
        Height="700" Width="1200"
        MinHeight="500" MinWidth="800"
        WindowStartupLocation="CenterScreen">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0" Background="{StaticResource PrimaryColor}" Padding="15">
            <TextBlock Text="403 Medical Imaging System" 
                       FontSize="20" 
                       FontWeight="Bold" 
                       Foreground="White"/>
        </Border>

        <!-- Main Content Area with Tabs -->
        <TabControl Grid.Row="1" Margin="10">

            <!-- Home Tab -->
            <TabItem Header="Home">
                <Grid Margin="20">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="200"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- Navigation Panel -->
                    <Border Grid.Column="0" 
                            Background="{StaticResource SecondaryColor}" 
                            Padding="10" 
                            Margin="0,0,10,0"
                            CornerRadius="5">
                        <StackPanel>
                            <Button Content="Dashboard" 
                                    Command="{Binding NavigateCommand}" 
                                    CommandParameter="Dashboard"
                                    Margin="0,5" 
                                    Padding="10"/>
                            <Button Content="Patients" 
                                    Command="{Binding NavigateCommand}" 
                                    CommandParameter="Patients"
                                    Margin="0,5" 
                                    Padding="10"/>
                            <Button Content="Settings" 
                                    Command="{Binding NavigateCommand}" 
                                    CommandParameter="Settings"
                                    Margin="0,5" 
                                    Padding="10"/>
                        </StackPanel>
                    </Border>

                    <!-- Content Area -->
                    <Border Grid.Column="1" 
                            Background="White" 
                            BorderBrush="#DDDDDD" 
                            BorderThickness="1"
                            CornerRadius="5"
                            Padding="20">
                        <StackPanel>
                            <TextBlock Text="{Binding CurrentPage}" 
                                       FontSize="24" 
                                       FontWeight="Bold"
                                       Margin="0,0,0,20"/>

                            <TextBlock Text="Welcome to 403 Medical Imaging System" 
                                       FontSize="14"
                                       TextWrapping="Wrap"
                                       Margin="0,0,0,20"/>

                            <TextBox Text="{Binding UserInput, UpdateSourceTrigger=PropertyChanged}" 
                                     Width="300" 
                                     HorizontalAlignment="Left"
                                     Margin="0,0,0,10"/>

                            <Button Content="Submit" 
                                    Command="{Binding SubmitCommand}"
                                    Width="100"
                                    HorizontalAlignment="Left"
                                    Padding="10,5"/>

                            <TextBlock Text="{Binding StatusMessage}" 
                                       Margin="0,20,0,0"
                                       FontStyle="Italic"
                                       Foreground="Gray"/>
                        </StackPanel>
                    </Border>
                </Grid>
            </TabItem>

            <!-- Image Viewer Tab -->
            <TabItem Header="Image Viewer">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- Toolbar -->
                    <Border Grid.Row="0" 
                            Background="{StaticResource SecondaryColor}" 
                            Padding="10"
                            BorderBrush="#CCCCCC"
                            BorderThickness="0,0,0,1">
                        <StackPanel Orientation="Horizontal">
                            <Button Content="Open Image" 
                                    Command="{Binding OpenImageCommand}"
                                    Padding="15,8"
                                    Margin="0,0,10,0"
                                    Background="#007ACC"
                                    Foreground="White"
                                    BorderThickness="0"
                                    Cursor="Hand"/>

                            <Button Content="Clear"
                                    Command="{Binding ClearImageCommand}"
                                    Padding="15,8"
                                    Margin="0,0,10,0"
                                    Background="#E0E0E0"
                                    BorderThickness="0"
                                    Cursor="Hand"/>

                            <Button Content="Save to Patient File"
                                    Command="{Binding SaveImageCommand}"
                                    Padding="15,8"
                                    Margin="0,0,10,0"
                                    Background="#6F42C1"
                                    Foreground="White"
                                    BorderThickness="0"
                                    Cursor="Hand"
                                    ToolTip="Save the current image as DICOM or PNG to a patient file"/>

                            <Separator Style="{StaticResource {x:Static ToolBar.SeparatorStyleKey}}"
                                       Margin="10,0"/>

                            <Button Content="Zoom In" 
                                    Command="{Binding ZoomInCommand}"
                                    Padding="15,8"
                                    Margin="0,0,5,0"
                                    Background="#F5F5F5"
                                    BorderThickness="1"
                                    BorderBrush="#CCCCCC"
                                    Cursor="Hand"/>

                            <Button Content="Zoom Out" 
                                    Command="{Binding ZoomOutCommand}"
                                    Padding="15,8"
                                    Margin="0,0,5,0"
                                    Background="#F5F5F5"
                                    BorderThickness="1"
                                    BorderBrush="#CCCCCC"
                                    Cursor="Hand"/>

                            <Button Content="Fit to Screen" 
                                    Command="{Binding FitToScreenCommand}"
                                    Padding="15,8"
                                    Margin="0,0,10,0"
                                    Background="#F5F5F5"
                                    BorderThickness="1"
                                    BorderBrush="#CCCCCC"
                                    Cursor="Hand"/>

                            <TextBlock Text="{Binding ZoomPercentage, StringFormat='{}{0:F0}%'}"
                                       VerticalAlignment="Center"
                                       Margin="10,0"
                                       FontWeight="SemiBold"/>

                            <!-- Scan Filter Controls -->
                            <Separator Style="{StaticResource {x:Static ToolBar.SeparatorStyleKey}}"
                                       Margin="10,0"/>

                            <Button Content="Scan Filter"
                                    Command="{Binding RunScanFilterCommand}"
                                    Padding="15,8"
                                    Margin="0,0,10,0"
                                    Background="#28A745"
                                    Foreground="White"
                                    BorderThickness="0"
                                    Cursor="Hand"
                                    ToolTip="Filter DICOM series using cardiogram data"/>

                            <TextBlock Text="{Binding FilterResultSummary}"
                                       VerticalAlignment="Center"
                                       Margin="0,0,10,0"
                                       FontStyle="Italic"
                                       Foreground="#555555"/>

                            <!-- Frame Navigation Controls -->
                            <Separator Style="{StaticResource {x:Static ToolBar.SeparatorStyleKey}}" 
                                       Margin="10,0"/>

                            <Button Content="|◄" 
                                    Command="{Binding FirstFrameCommand}"
                                    Padding="10,8"
                                    Margin="0,0,5,0"
                                    Background="#F5F5F5"
                                    BorderThickness="1"
                                    BorderBrush="#CCCCCC"
                                    Cursor="Hand"
                                    ToolTip="First Frame (Shift+Left)"/>

                            <Button Content="◄" 
                                    Command="{Binding PreviousFrameCommand}"
                                    Padding="15,8"
                                    Margin="0,0,5,0"
                                    Background="#F5F5F5"
                                    BorderThickness="1"
                                    BorderBrush="#CCCCCC"
                                    Cursor="Hand"
                                    ToolTip="Previous Frame (Left Arrow)"/>

                            <TextBlock Text="{Binding FrameInfo}" 
                                       VerticalAlignment="Center"
                                       Margin="10,0"
                                       MinWidth="100"
                                       TextAlignment="Center"
                                       FontWeight="SemiBold"/>

                            <Button Content="►" 
                                    Command="{Binding NextFrameCommand}"
                                    Padding="15,8"
                                    Margin="0,0,5,0"
                                    Background="#F5F5F5"
                                    BorderThickness="1"
                                    BorderBrush="#CCCCCC"
                                    Cursor="Hand"
                                    ToolTip="Next Frame (Right Arrow)"/>

                            <Button Content="►|" 
                                    Command="{Binding LastFrameCommand}"
                                    Padding="10,8"
                                    Margin="0,0,0,0"
                                    Background="#F5F5F5"
                                    BorderThickness="1"
                                    BorderBrush="#CCCCCC"
                                    Cursor="Hand"
                                    ToolTip="Last Frame (Shift+Right)"/>
                        </StackPanel>
                    </Border>

                    <!-- Image Display Area -->
                    <Border Grid.Row="1" 
                            Background="#2B2B2B"
                            BorderBrush="#CCCCCC"
                            BorderThickness="1">
                        <ScrollViewer HorizontalScrollBarVisibility="Auto" 
                                      VerticalScrollBarVisibility="Auto"
                                      x:Name="ImageScrollViewer">
                            <Canvas Background="Transparent"
                                    MouseWheel="Canvas_MouseWheel"
                                    MouseLeftButtonDown="Canvas_MouseLeftButtonDown"
                                    MouseLeftButtonUp="Canvas_MouseLeftButtonUp"
                                    MouseMove="Canvas_MouseMove">
                                <Image x:Name="DisplayImage"
                                       Source="{Binding CurrentImageSource}"
                                       RenderOptions.BitmapScalingMode="HighQuality"
                                       Stretch="None">
                                    <Image.LayoutTransform>
                                        <ScaleTransform ScaleX="{Binding ZoomLevel}" 
                                                        ScaleY="{Binding ZoomLevel}"/>
                                    </Image.LayoutTransform>
                                </Image>

                                <!-- Markup Canvas (for future annotations) -->
                                <Canvas x:Name="MarkupCanvas" 
                                        Background="Transparent"
                                        Width="{Binding ElementName=DisplayImage, Path=ActualWidth}"
                                        Height="{Binding ElementName=DisplayImage, Path=ActualHeight}">
                                    <Canvas.LayoutTransform>
                                        <ScaleTransform ScaleX="{Binding ZoomLevel}" 
                                                        ScaleY="{Binding ZoomLevel}"/>
                                    </Canvas.LayoutTransform>
                                </Canvas>
                            </Canvas>
                        </ScrollViewer>
                    </Border>

                    <!-- Image Info Bar -->
                    <Border Grid.Row="2" 
                            Background="{StaticResource SecondaryColor}" 
                            Padding="10"
                            BorderBrush="#CCCCCC"
                            BorderThickness="0,1,0,0">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <TextBlock Grid.Column="0"
                                       Text="{Binding ImageInfo}" 
                                       VerticalAlignment="Center"/>

                            <TextBlock Grid.Column="1"
                                       Text="{Binding ImageDimensions}"
                                       VerticalAlignment="Center"
                                       Margin="20,0,0,0"/>
                        </Grid>
                    </Border>
                </Grid>
            </TabItem>

            <!-- Cardiac Gating Tab -->
            <TabItem Header="Cardiac Gating">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- Input Selection Panel -->
                    <Border Grid.Row="0"
                            Background="{StaticResource SecondaryColor}"
                            Padding="15"
                            BorderBrush="#CCCCCC"
                            BorderThickness="0,0,0,1">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <!-- Heart Rate CSV Selection -->
                            <Grid Grid.Row="0" Margin="0,0,0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="140"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <TextBlock Grid.Column="0"
                                           Text="Heart Rate CSV:"
                                           VerticalAlignment="Center"
                                           FontWeight="SemiBold"/>

                                <Border Grid.Column="1"
                                        Background="White"
                                        BorderBrush="#AAAAAA"
                                        BorderThickness="1"
                                        CornerRadius="3"
                                        Padding="8,5"
                                        Margin="0,0,8,0">
                                    <TextBlock Text="{Binding SelectedCsvFileName}"
                                               VerticalAlignment="Center"
                                               TextTrimming="CharacterEllipsis"
                                               ToolTip="{Binding SelectedCsvPath}"
                                               Foreground="#333333"/>
                                </Border>

                                <Button Grid.Column="2"
                                        Content="Browse..."
                                        Command="{Binding BrowseCsvCommand}"
                                        Padding="15,5"
                                        Background="#007ACC"
                                        Foreground="White"
                                        BorderThickness="0"
                                        Cursor="Hand"/>
                            </Grid>

                            <!-- MRD File Selection -->
                            <Grid Grid.Row="1" Margin="0,0,0,10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="140"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <TextBlock Grid.Column="0"
                                           Text="MRI Data (MRD):"
                                           VerticalAlignment="Center"
                                           FontWeight="SemiBold"/>

                                <Border Grid.Column="1"
                                        Background="White"
                                        BorderBrush="#AAAAAA"
                                        BorderThickness="1"
                                        CornerRadius="3"
                                        Padding="8,5"
                                        Margin="0,0,8,0">
                                    <TextBlock Text="{Binding SelectedMrdFileName}"
                                               VerticalAlignment="Center"
                                               TextTrimming="CharacterEllipsis"
                                               ToolTip="{Binding SelectedMrdPath}"
                                               Foreground="#333333"/>
                                </Border>

                                <Button Grid.Column="2"
                                        Content="Browse..."
                                        Command="{Binding BrowseMrdCommand}"
                                        Padding="15,5"
                                        Background="#007ACC"
                                        Foreground="White"
                                        BorderThickness="0"
                                        Cursor="Hand"/>
                            </Grid>

                            <!-- Action Buttons and Status -->
                            <StackPanel Grid.Row="2" Orientation="Horizontal">
                                <Button Content="Run Cardiac Gating"
                                        Command="{Binding RunCardiacGatingCommand}"
                                        Padding="20,8"
                                        Margin="0,0,10,0"
                                        Background="#28A745"
                                        Foreground="White"
                                        FontWeight="SemiBold"
                                        BorderThickness="0"
                                        Cursor="Hand"
                                        IsEnabled="{Binding CanRunGating}"
                                        ToolTip="Select both files above, then click to run"/>

                                <Button Content="Clear"
                                        Command="{Binding ClearGatingInputsCommand}"
                                        Padding="15,8"
                                        Margin="0,0,15,0"
                                        Background="#E0E0E0"
                                        BorderThickness="0"
                                        Cursor="Hand"/>
                            </StackPanel>

                            <!-- Result / Error Display -->
                            <ScrollViewer Grid.Row="3" MaxHeight="120"
                                          VerticalScrollBarVisibility="Auto"
                                          Margin="0,5,0,0">
                                <TextBlock Text="{Binding GatingResultSummary}"
                                           FontFamily="Consolas"
                                           FontSize="11"
                                           Foreground="#555555"
                                           TextWrapping="Wrap"/>
                            </ScrollViewer>
                        </Grid>
                    </Border>

                    <!-- Gated Image Display Area -->
                    <Border Grid.Row="1"
                            Background="#2B2B2B"
                            BorderBrush="#CCCCCC"
                            BorderThickness="1">
                        <ScrollViewer HorizontalScrollBarVisibility="Auto"
                                      VerticalScrollBarVisibility="Auto">
                            <Image Source="{Binding CurrentImageSource}"
                                   RenderOptions.BitmapScalingMode="HighQuality"
                                   Stretch="None">
                                <Image.LayoutTransform>
                                    <ScaleTransform ScaleX="{Binding ZoomLevel}"
                                                    ScaleY="{Binding ZoomLevel}"/>
                                </Image.LayoutTransform>
                            </Image>
                        </ScrollViewer>
                    </Border>

                    <!-- Gating Info Bar with Frame Navigation -->
                    <Border Grid.Row="2"
                            Background="{StaticResource SecondaryColor}"
                            Padding="10"
                            BorderBrush="#CCCCCC"
                            BorderThickness="0,1,0,0">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <TextBlock Grid.Column="0"
                                       Text="{Binding ImageInfo}"
                                       VerticalAlignment="Center"/>

                            <!-- Frame navigation -->
                            <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="10,0">
                                <Button Content="|&#9668;"
                                        Command="{Binding FirstFrameCommand}"
                                        Padding="8,4" Margin="0,0,3,0"
                                        Background="#F5F5F5" BorderThickness="1" BorderBrush="#CCCCCC" Cursor="Hand"/>
                                <Button Content="&#9668;"
                                        Command="{Binding PreviousFrameCommand}"
                                        Padding="10,4" Margin="0,0,3,0"
                                        Background="#F5F5F5" BorderThickness="1" BorderBrush="#CCCCCC" Cursor="Hand"/>
                                <TextBlock Text="{Binding FrameInfo}"
                                           VerticalAlignment="Center"
                                           Margin="8,0"
                                           MinWidth="100"
                                           TextAlignment="Center"
                                           FontWeight="SemiBold"/>
                                <Button Content="&#9658;"
                                        Command="{Binding NextFrameCommand}"
                                        Padding="10,4" Margin="0,0,3,0"
                                        Background="#F5F5F5" BorderThickness="1" BorderBrush="#CCCCCC" Cursor="Hand"/>
                                <Button Content="&#9658;|"
                                        Command="{Binding LastFrameCommand}"
                                        Padding="8,4"
                                        Background="#F5F5F5" BorderThickness="1" BorderBrush="#CCCCCC" Cursor="Hand"/>
                            </StackPanel>

                            <TextBlock Grid.Column="2"
                                       Text="{Binding ImageDimensions}"
                                       VerticalAlignment="Center"
                                       Margin="10,0,0,0"/>
                        </Grid>
                    </Border>
                </Grid>
            </TabItem>

            <!-- Patients Tab -->
            <TabItem Header="Patients">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="320"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- Left Panel: Patient List -->
                    <Border Grid.Column="0"
                            Background="{StaticResource SecondaryColor}"
                            BorderBrush="#CCCCCC"
                            BorderThickness="0,0,1,0">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <!-- Search Bar -->
                            <Border Grid.Row="0" Padding="10"
                                    BorderBrush="#CCCCCC" BorderThickness="0,0,0,1">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <TextBox Grid.Column="0"
                                             Text="{Binding PatientSearchQuery, UpdateSourceTrigger=PropertyChanged}"
                                             Padding="8,6"
                                             Margin="0,0,5,0"
                                             ToolTip="Search by name or MRN"/>

                                    <Button Grid.Column="1"
                                            Content="Search"
                                            Command="{Binding SearchPatientsCommand}"
                                            Padding="12,6"
                                            Background="#007ACC"
                                            Foreground="White"
                                            BorderThickness="0"
                                            Cursor="Hand"/>
                                </Grid>
                            </Border>

                            <!-- Patient List -->
                            <ListBox Grid.Row="1"
                                     ItemsSource="{Binding Patients}"
                                     SelectedItem="{Binding SelectedPatient}"
                                     Margin="5"
                                     BorderThickness="0"
                                     Background="Transparent">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel Margin="5,4">
                                            <TextBlock Text="{Binding FullName}"
                                                       FontWeight="SemiBold"
                                                       FontSize="13"/>
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="MRN: "
                                                           Foreground="#777777"
                                                           FontSize="11"/>
                                                <TextBlock Text="{Binding MedicalRecordNumber}"
                                                           Foreground="#777777"
                                                           FontSize="11"/>
                                                <TextBlock Text="  |  DOB: "
                                                           Foreground="#777777"
                                                           FontSize="11"/>
                                                <TextBlock Text="{Binding DateOfBirth, StringFormat='{}{0:MM/dd/yyyy}'}"
                                                           Foreground="#777777"
                                                           FontSize="11"/>
                                            </StackPanel>
                                        </StackPanel>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>

                            <!-- New Patient Button -->
                            <Border Grid.Row="2" Padding="10"
                                    BorderBrush="#CCCCCC" BorderThickness="0,1,0,0">
                                <Button Content="+ New Patient"
                                        Command="{Binding NewPatientCommand}"
                                        Padding="12,8"
                                        Background="#28A745"
                                        Foreground="White"
                                        FontWeight="SemiBold"
                                        BorderThickness="0"
                                        Cursor="Hand"
                                        HorizontalAlignment="Stretch"/>
                            </Border>
                        </Grid>
                    </Border>

                    <!-- Right Panel: Patient Detail Form -->
                    <Border Grid.Column="1" Background="White">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <ScrollViewer Grid.Row="0"
                                          VerticalScrollBarVisibility="Auto"
                                          Padding="20,15">
                                <StackPanel>
                                    <TextBlock Text="Patient Profile"
                                               FontSize="20"
                                               FontWeight="Bold"
                                               Margin="0,0,0,15"/>

                                    <!-- Personal Information -->
                                    <TextBlock Text="Personal Information"
                                               FontSize="14"
                                               FontWeight="SemiBold"
                                               Foreground="#007ACC"
                                               Margin="0,0,0,8"/>

                                    <Grid Margin="0,0,0,8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="15"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>

                                        <StackPanel Grid.Column="0">
                                            <TextBlock Text="First Name *" FontWeight="SemiBold" Margin="0,0,0,3"/>
                                            <TextBox Text="{Binding PatFirstName, UpdateSourceTrigger=PropertyChanged}"
                                                     Padding="8,6"/>
                                        </StackPanel>

                                        <StackPanel Grid.Column="2">
                                            <TextBlock Text="Last Name *" FontWeight="SemiBold" Margin="0,0,0,3"/>
                                            <TextBox Text="{Binding PatLastName, UpdateSourceTrigger=PropertyChanged}"
                                                     Padding="8,6"/>
                                        </StackPanel>
                                    </Grid>

                                    <Grid Margin="0,0,0,8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="15"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="15"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>

                                        <StackPanel Grid.Column="0">
                                            <TextBlock Text="Date of Birth *" FontWeight="SemiBold" Margin="0,0,0,3"/>
                                            <DatePicker SelectedDate="{Binding PatDateOfBirth}"
                                                        Padding="4,4"/>
                                        </StackPanel>

                                        <StackPanel Grid.Column="2">
                                            <TextBlock Text="Gender" FontWeight="SemiBold" Margin="0,0,0,3"/>
                                            <ComboBox SelectedValue="{Binding PatGender}"
                                                      Padding="8,6"
                                                      IsEditable="True">
                                                <ComboBoxItem Content="Male"/>
                                                <ComboBoxItem Content="Female"/>
                                                <ComboBoxItem Content="Other"/>
                                            </ComboBox>
                                        </StackPanel>

                                        <StackPanel Grid.Column="4">
                                            <TextBlock Text="Medical Record # (MRN)" FontWeight="SemiBold" Margin="0,0,0,3"/>
                                            <TextBox Text="{Binding PatMrn, UpdateSourceTrigger=PropertyChanged}"
                                                     Padding="8,6"/>
                                        </StackPanel>
                                    </Grid>

                                    <!-- Separator -->
                                    <Separator Margin="0,10"/>

                                    <!-- Contact Information -->
                                    <TextBlock Text="Contact Information"
                                               FontSize="14"
                                               FontWeight="SemiBold"
                                               Foreground="#007ACC"
                                               Margin="0,5,0,8"/>

                                    <Grid Margin="0,0,0,8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="15"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>

                                        <StackPanel Grid.Column="0">
                                            <TextBlock Text="Phone Number" FontWeight="SemiBold" Margin="0,0,0,3"/>
                                            <TextBox Text="{Binding PatPhone, UpdateSourceTrigger=PropertyChanged}"
                                                     Padding="8,6"/>
                                        </StackPanel>

                                        <StackPanel Grid.Column="2">
                                            <TextBlock Text="Email" FontWeight="SemiBold" Margin="0,0,0,3"/>
                                            <TextBox Text="{Binding PatEmail, UpdateSourceTrigger=PropertyChanged}"
                                                     Padding="8,6"/>
                                        </StackPanel>
                                    </Grid>

                                    <StackPanel Margin="0,0,0,8">
                                        <TextBlock Text="Address" FontWeight="SemiBold" Margin="0,0,0,3"/>
                                        <TextBox Text="{Binding PatAddress, UpdateSourceTrigger=PropertyChanged}"
                                                 Padding="8,6"/>
                                    </StackPanel>

                                    <!-- Separator -->
                                    <Separator Margin="0,10"/>

                                    <!-- Emergency Contact -->
                                    <TextBlock Text="Emergency Contact"
                                               FontSize="14"
                                               FontWeight="SemiBold"
                                               Foreground="#007ACC"
                                               Margin="0,5,0,8"/>

                                    <Grid Margin="0,0,0,8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="15"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>

                                        <StackPanel Grid.Column="0">
                                            <TextBlock Text="Contact Name" FontWeight="SemiBold" Margin="0,0,0,3"/>
                                            <TextBox Text="{Binding PatEmergencyName, UpdateSourceTrigger=PropertyChanged}"
                                                     Padding="8,6"/>
                                        </StackPanel>

                                        <StackPanel Grid.Column="2">
                                            <TextBlock Text="Contact Phone" FontWeight="SemiBold" Margin="0,0,0,3"/>
                                            <TextBox Text="{Binding PatEmergencyPhone, UpdateSourceTrigger=PropertyChanged}"
                                                     Padding="8,6"/>
                                        </StackPanel>
                                    </Grid>

                                    <!-- Separator -->
                                    <Separator Margin="0,10"/>

                                    <!-- Medical Notes -->
                                    <TextBlock Text="Medical Notes"
                                               FontSize="14"
                                               FontWeight="SemiBold"
                                               Foreground="#007ACC"
                                               Margin="0,5,0,8"/>

                                    <TextBox Text="{Binding PatNotes, UpdateSourceTrigger=PropertyChanged}"
                                             Padding="8,6"
                                             AcceptsReturn="True"
                                             TextWrapping="Wrap"
                                             MinHeight="80"
                                             MaxHeight="160"
                                             VerticalScrollBarVisibility="Auto"/>
                                </StackPanel>
                            </ScrollViewer>

                            <!-- Action Bar -->
                            <Border Grid.Row="1"
                                    Background="{StaticResource SecondaryColor}"
                                    Padding="15,10"
                                    BorderBrush="#CCCCCC"
                                    BorderThickness="0,1,0,0">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>

                                    <Button Grid.Column="0"
                                            Content="Save Patient"
                                            Command="{Binding SavePatientCommand}"
                                            Padding="20,8"
                                            Margin="0,0,8,0"
                                            Background="#28A745"
                                            Foreground="White"
                                            FontWeight="SemiBold"
                                            BorderThickness="0"
                                            Cursor="Hand"/>

                                    <Button Grid.Column="1"
                                            Content="Delete"
                                            Command="{Binding DeletePatientCommand}"
                                            Padding="15,8"
                                            Margin="0,0,8,0"
                                            Background="#DC3545"
                                            Foreground="White"
                                            BorderThickness="0"
                                            Cursor="Hand"/>

                                    <Button Grid.Column="2"
                                            Content="Clear Form"
                                            Command="{Binding ClearPatientFormCommand}"
                                            Padding="15,8"
                                            Margin="0,0,15,0"
                                            Background="#E0E0E0"
                                            BorderThickness="0"
                                            Cursor="Hand"/>

                                    <TextBlock Grid.Column="4"
                                               Text="{Binding PatientStatusMessage}"
                                               VerticalAlignment="Center"
                                               HorizontalAlignment="Right"
                                               FontStyle="Italic"
                                               Foreground="#555555"
                                               TextTrimming="CharacterEllipsis"/>
                                </Grid>
                            </Border>
                        </Grid>
                    </Border>
                </Grid>
            </TabItem>

        </TabControl>

        <!-- Status Bar -->
        <Border Grid.Row="2" 
                Background="{StaticResource SecondaryColor}" 
                Padding="10,5">
            <TextBlock Text="{Binding StatusText}" 
                       Foreground="{StaticResource TextColor}"/>
        </Border>
    </Grid>
</Window>