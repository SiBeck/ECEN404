<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <RootNamespace>_403DesktopApp</RootNamespace>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <AllowUnsafeBlocks>True</AllowUnsafeBlocks>
  </PropertyGroup>

  <ItemGroup>
    <Folder Include="Views\" />
  </ItemGroup>

  <!-- Remove implicit global usings that conflict with WPF types
       (Application, MouseEventArgs, KeyEventArgs, Point, etc.) -->
  <ItemGroup>
    <Using Remove="System.Windows.Forms" />
    <Using Remove="System.Drawing" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="fo-dicom" Version="5.2.4" />
    <PackageReference Include="pythonnet" Version="3.0.4" />
    <PackageReference Include="fo-dicom.Codecs" Version="5.16.4" />
    <PackageReference Include="fo-dicom.Desktop" Version="4.0.8" />
    <PackageReference Include="System.Drawing.Common" Version="9.0.9" />
    <PackageReference Include="SixLabors.ImageSharp" Version="3.1.7" />
    <PackageReference Include="Microsoft.Extensions.Http" Version="8.0.1" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\CardiacGatingMRI\CardiacGatingMRI.csproj" />
  </ItemGroup>

	<ItemGroup>
		<Compile Update="LoginWindow.xaml.cs">
			<DependentUpon>LoginWindow.xaml</DependentUpon>
		</Compile>
	</ItemGroup>

</Project>
